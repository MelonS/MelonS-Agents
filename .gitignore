# =============================================================================
# Records (Data layer — outputs from agent runs, NEVER committed)
# =============================================================================
records/
!records/.gitkeep

# =============================================================================
# Music pool (local-only — NEVER committed, regardless of source license).
# A "free to use in your video" license (YouTube Audio Library, Pixabay,
# etc.) is NOT the same as a "free to redistribute the file" license.
# The repo is public + promoted; committing audio files would mean
# redistribution, which is a separate license question we don't want to
# resolve per track.  Operators source their own tracks locally and
# point FACELESS_BGM_FILE at the local path.  Only README.md + .gitkeep
# in assets/music/ are tracked.
# =============================================================================
assets/music/*
!assets/music/.gitkeep
!assets/music/README.md
!assets/music/SOURCES.md
# Media outputs anywhere in the tree
*.mp4
*.mov
*.mkv
*.webm
*.avi
*.mp3
*.wav
*.flac
*.m4a
*.opus
# Image outputs (allow doc images via explicit !docs/*.png if needed later)
*.png
*.jpg
# Caption-verify proof frames are committed evidence
!docs/caption-verify/*.jpg
# Shorts-batch demo evidence committed
!docs/shorts-batch-demo/*.jpg
# Faceless pilot thumbnails — committed evidence (full MP4s stay in records/)
!docs/pilots/screens/*.jpg
# Sonnet-trial caption-verify thumbnails (v6 Sonnet-script benchmark)
!docs/pilots/sonnet-trial/screens/*.jpg
# Music-trial caption-verify thumbnails (4 topics × EN/KO)
!docs/pilots/music-trial/screens/*.jpg
# Onboarding preview frames (demo-mode + future onboarding evidence)
!docs/onboarding/*.jpg
# Metrics charts (generated by scripts/generate-charts.py, committed evidence)
!docs/metrics/*.png
# GitHub Pages assets (site/ is the Pages source — bundle of evidence frames)
!site/assets/*.jpg
!site/assets/*.png
*.jpeg
*.gif
# Demo GIFs (highlight + v6 preview)
!docs/demo/*.gif
# Animated demo previews — short ffmpeg-generated GIFs, committed evidence
!docs/demo/*.gif
# GitHub Pages animated demo
!site/assets/*.gif
*.webp
# Generated transcripts / captions / SRT
*.srt
*.vtt
*.ass

# =============================================================================
# Secrets & env
# =============================================================================
.env
.env.local
.env.*.local
*.local
secrets/
*.pem
*.key
*.p12

# =============================================================================
# Temp / scratch
# =============================================================================
tmp/
temp/
scratch/
*.tmp
*.bak
*.swp
*.swo
*~

# =============================================================================
# Logs
# =============================================================================
*.log
logs/
# Faceless-pilot correction logs are committed evidence (short, append-only,
# read by docs/pilots/decision-log.md as part of the deliverable trail).
!docs/pilots/screens/*-corrections.log

# =============================================================================
# OS / editor cruft
# =============================================================================
.DS_Store
Thumbs.db
.vscode/
.idea/

# =============================================================================
# Language runtime artifacts
# =============================================================================
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
node_modules/
dist/
build/
*.egg-info/

# =============================================================================
# Claude Code local state (agent DEFINITIONS under .claude/agents/ ARE tracked)
# =============================================================================
.claude/sessions/
.claude/cache/
.claude/logs/
.claude/settings.local.json
.claude/.last-session
# Claude Code scheduled-wakeup / runtime lock files
.claude/*.lock

# Per-user statusline scripts generated by cc-statusline init or plugin backups
.claude/statusline.sh
.claude/statusline.sh.*

# launchd plists are rendered from *.plist.template by
# scripts/install-scheduler.sh — the rendered files contain
# machine-specific absolute paths and are not source of truth.
scripts/com.melons.agents.*.plist
.claude/settings.json
.claude/skills

# Per-operator job-hunt filter — contains personal job-seeker context
# (specific 직군, 지역, exclusion lists, etc.).  Per
# [[repo-as-credibility-signal]] memory rule, employment-angle
# specifics do not belong in committed files.  filters.example.yaml
# ships as the generic template; operators copy to filters.yaml and
# edit locally.
skills/job-hunt/config/filters.yaml

# Per-operator profile — narrative description of strengths, gaps,
# role-target, etc.  Used by Phase 2.3+ Claude-call fit-scoring as
# the operator-side context.  Like filters.yaml, contains
# personally-revealing content and is gitignored by default.
# operator-profile.example.md is the generic template that stays
# committed.
skills/job-hunt/config/operator-profile.md

# Per-operator publish artifacts — YouTube/social upload packs,
# scheduling notes, draft copy.  Routinely contain channel-handle,
# unposted titles/descriptions, and operator-personal context that
# fails the [[no-pii-in-repo]] bar.  outputs/ is loosely structured
# so guard the publish/ subdir explicitly.
outputs/publish/*.md
outputs/publish/upload-meta/
# Future batches: v2 / v3 / etc.  v2 was committed intentionally by
# the parallel music-video session on 2026-05-21 (commit a182380);
# any further-version metadata-batch directories should NOT be
# committed by default.
outputs/publish/upload-meta-v[3-9]*/

# Review-queue — local-only batch taste-decision cache.  Only the
# README.md + .gitkeep are tracked; the pending/ and decided/ subdirs
# carry per-machine artifact metadata that fails [[no-pii-in-repo]]
# (file paths, music titles, mood keywords, sometimes operator
# preferences).  See outputs/review-queue/README.md.
outputs/review-queue/pending/
outputs/review-queue/decided/
