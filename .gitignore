# Logs
# =============================================================================
*.log
logs/
# Faceless-pilot correction logs are committed evidence (short, append-only,
# read by docs/pilots/decision-log.md as part of the deliverable trail).
!docs/pilots/screens/*-corrections.log

# =============================================================================
# OS / editor cruft
# =============================================================================
.DS_Store
Thumbs.db
.vscode/
.idea/

# =============================================================================
# Language runtime artifacts
# =============================================================================
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
node_modules/
dist/
build/
*.egg-info/

# -----------------------------------------------------------------------------
# site/play/ — GitHub Pages 로 배포되는 WebGL 빌드.  위의 전역 `*.png`(33행) 와
# `build/`(Windows 는 core.ignorecase=true 라 `Build/` 도 잡는다) 에서 예외 처리한다.
#
# 이게 없으면 17개 중 3개만 커밋되고도 push·Pages 워크플로가 전부 "성공"으로 끝난다.
# 결손은 브라우저에서 TemplateData/*.png 404 + 로딩바 무한으로만 드러난다
# (2026-07-26 실제 사고 — 디스크에 파일이 있어서 로컬 검증은 통과했다).
#
# 부모 디렉터리가 제외되면 내부 파일을 되살릴 수 없으므로 디렉터리부터 푼다.
# -----------------------------------------------------------------------------
!site/play/
!site/play/Build/
!site/play/**

# =============================================================================
# Claude Code local state (agent DEFINITIONS under .claude/agents/ ARE tracked)
# =============================================================================
.claude/sessions/
.claude/cache/
.claude/logs/
.claude/settings.local.json
.claude/.last-session
# Claude Code scheduled-wakeup / runtime lock files
.claude/*.lock

# Per-user statusline scripts generated by cc-statusline init or plugin backups
.claude/statusline.sh
.claude/statusline.sh.*

# launchd plists are rendered from *.plist.template by
# scripts/install-scheduler.sh — the rendered files contain
# machine-specific absolute paths and are not source of truth.
scripts/com.melons.agents.*.plist
.claude/settings.json
.claude/skills

# Per-operator job-hunt filter — contains personal job-seeker context
# (specific 직군, 지역, exclusion lists, etc.).  Per
# [[repo-as-credibility-signal]] memory rule, employment-angle
# specifics do not belong in committed files.  filters.example.yaml
# ships as the generic template; operators copy to filters.yaml and
# edit locally.
skills/job-hunt/config/filters.yaml

# Per-operator profile — narrative description of strengths, gaps,
# role-target, etc.  Used by Phase 2.3+ Claude-call fit-scoring as
# the operator-side context.  Like filters.yaml, contains
# personally-revealing content and is gitignored by default.
# operator-profile.example.md is the generic template that stays
# committed.
skills/job-hunt/config/operator-profile.md

# Per-operator publish artifacts — YouTube/social upload packs,
# scheduling notes, draft copy.  Routinely contain channel-handle,
# unposted titles/descriptions, and operator-personal context that
# fails the [[no-pii-in-repo]] bar.  outputs/ is loosely structured
# so guard the publish/ subdir explicitly.
outputs/publish/*.md
outputs/publish/upload-meta/
# Future batches: v2 / v3 / etc.  v2 was committed intentionally by
# the parallel music-video session on 2026-05-21 (commit a182380);
# any further-version metadata-batch directories should NOT be
# committed by default.
outputs/publish/upload-meta-v[3-9]*/

# ffmpeg transient concat list files — emitted by mix2-build.py during
# compose stage, regenerated on every run, no source of truth.
outputs/publish/*/_concat.txt
outputs/publish/**/_concat.txt

# =============================================================================
# Unity project — only Assets/ + ProjectSettings/ + Packages/ source tracked.
# Library/ / Temp/ / Logs/ / UserSettings/ / Build outputs are machine-local.
# Game asset PNGs ARE tracked (override the global *.png ignore) since they
# ARE source content for the game prototype Skill #3.
# =============================================================================
skills/game-prototype/unity-project/Library/
skills/game-prototype/unity-project/Temp/
skills/game-prototype/unity-project/Logs/
skills/game-prototype/unity-project/UserSettings/
skills/game-prototype/unity-project/obj/
skills/game-prototype/unity-project/Build/
skills/game-prototype/unity-project/Builds/
skills/game-prototype/unity-project/*.csproj
skills/game-prototype/unity-project/*.sln
skills/game-prototype/unity-project/.vs/
# Performance Testing 패키지가 임포트 때마다 Resources/ 에 떨어뜨리는 런 설정 —
# 프로젝트 자산이 아니라 실행 산출물이다.
skills/game-prototype/unity-project/Assets/Resources/PerformanceTestRun*.json
skills/game-prototype/unity-project/Assets/Resources/PerformanceTestRun*.json.meta

# Re-allow game art PNGs (override global *.png ignore)
!skills/game-prototype/unity-project/Assets/**/*.png
!skills/game-prototype/unity-project/Assets/**/*.jpg
!skills/game-prototype/unity-project/Assets/**/*.tga
!skills/game-prototype/unity-project/Assets/**/*.wav
!skills/game-prototype/unity-project/Assets/**/*.mp3
!skills/game-prototype/unity-project/Assets/**/*.ogg

# Daily build snapshots — too big for repo, machine-local
skills/game-prototype/builds/

