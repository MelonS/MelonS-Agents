--- !u!114 &1837094440
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1837094438}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5af769239984d394ba089690ec809b44, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  tips:
  - startTime: 1
    duration: 5
    text: "\uCF5C\uB85C\uB2C8\uC2A4\uD2B8\uB97C \uC88C\uD074\uB9AD\uD558\uBA74 \uC120\uD0DD,\n\uBE48
      \uACF3\uC744 \uC6B0\uD074\uB9AD\uD558\uBA74 \uC774\uB3D9\uD569\uB2C8\uB2E4."
  - startTime: 7
    duration: 5
    text: "\uB098\uBB34\xB7\uC791\uBB3C \uC6B0\uD074\uB9AD = \uC791\uC5C5.\n\uC801/\uB291\uB300\uB294
      [\uC9D5\uC9D1] \uD6C4 \uC6B0\uD074\uB9AD = \uACF5\uACA9."
  - startTime: 13
    duration: 5
    text: "\uD654\uBA74 \uD558\uB2E8 \uBC84\uD2BC\uC73C\uB85C \uC2DC\uAC04/\uBE4C\uB4DC/\uC5F0\uAD6C
      \uC81C\uC5B4.\nSpace \uB85C \uD301 \uAC74\uB108\uB6F0\uAE30."
  - startTime: 19
