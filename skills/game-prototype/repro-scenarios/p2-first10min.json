{
  "name": "신규 플레이어 첫 10분 통합 게이트 (2026-07-24 승격 — 운영자 'QA 보강 3번'. 실제 동선: 림 선택→벌목 지정→건축(벽4+문+침대+화덕)→배속→밤 관찰. 효과 어서션: 벌목지정 + 청사진 7종 배치. 장시간 sim 구간은 크래시 감시 역할)",
  "timeoutSec": 600,
  "steps": [
    { "op": "wait", "sec": 2 },
    { "op": "shot", "name": "p00_start" },

    { "op": "worldclick", "target": "pawn" },
    { "op": "shot", "name": "p01_selected" },
    { "op": "worldright", "target": "tree" },
    { "op": "wait", "sec": 1 },
    { "op": "shot", "name": "p02_chop_ordered" },
    { "op": "assert", "probe": "chopDesignations", "min": 1 },

    { "op": "clickui", "name": "label:건축" },
    { "op": "clickui", "name": "label:구조" },
    { "op": "wait", "sec": 0.4 },
    { "op": "shot", "name": "p03_shelf_open" },
    { "op": "clickui", "name": "label:목재 벽" },
    { "op": "worldclick", "x": 3.5, "y": 4.5 },
    { "op": "worldclick", "x": 4.5, "y": 4.5 },
    { "op": "worldclick", "x": 5.5, "y": 4.5 },
    { "op": "worldclick", "x": 6.5, "y": 4.5 },
    { "op": "shot", "name": "p04_walls_placed" },
    { "op": "clickui", "name": "label:문" },
    { "op": "worldclick", "x": 7.5, "y": 4.5 },
    { "op": "shot", "name": "p05_door_placed" },

    { "op": "clickui", "name": "label:가구" },
    { "op": "wait", "sec": 0.4 },
    { "op": "clickui", "name": "label:침대" },
    { "op": "worldclick", "x": 8.5, "y": 6.5 },
    { "op": "clickui", "name": "label:생산" },
    { "op": "wait", "sec": 0.4 },
    { "op": "clickui", "name": "label:화덕" },
    { "op": "worldclick", "x": 6.5, "y": 6.5 },
    { "op": "key", "name": "Escape" },
    { "op": "shot", "name": "p06_bed_stove_placed" },
    { "op": "assert", "probe": "blueprintCount", "min": 5 },

    { "op": "speed", "x": 4 },
    { "op": "wait", "sec": 120 },
    { "op": "shot", "name": "p07_construction_progress" },
    { "op": "wait", "sec": 240 },
    { "op": "shot", "name": "p08_evening" },
    { "op": "setHour", "x": 23 },
    { "op": "wait", "sec": 30 },
    { "op": "shot", "name": "p09_night_sleep" }
  ]
}
