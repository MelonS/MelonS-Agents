// auto-generated by `agent.py gen-editor-scaffold`.
//
// Two entry points for the Unity batchmode build pipeline:
//   - BuildWindows()          : full menu-first build, day-tagged folder
//   - BuildGameOnlyVerify()   : single-scene Game-direct build, used by
//                               agent.py qa.py for the autonomous
//                               self-verify loop (skips MainMenu so
//                               AutoScreenshotter captures gameplay
//                               state directly, no click required).
//
// CLI:
//   Unity.exe -batchmode -quit -projectPath ... -executeMethod
//   {{NAMESPACE}}.EditorTools.BuildScript.BuildWindows
//
// MELONS_BUILD_DAY env var = build folder tag.  Defaults to "X".

using System.IO;
using UnityEngine;
using UnityEditor;
using UnityEditor.Build.Reporting;

namespace {{NAMESPACE}}.EditorTools
{
    public static class BuildScript
    {
        private const string ExeName = "{{EXE_NAME}}.exe";
        private const string BuildDir = "../builds";
        private const string GameScene = "Assets/Scenes/Game.unity";
        private const string MenuScene = "Assets/Scenes/MainMenu.unity";

        public static void BuildGameOnlyVerify()
        {
            Directory.CreateDirectory(BuildDir);
            string outDir = Path.Combine(BuildDir, "verify");
            Directory.CreateDirectory(outDir);
            string outExe = Path.Combine(outDir, ExeName);
            var options = new BuildPlayerOptions
            {
                scenes = new[] { GameScene },
                locationPathName = outExe,
                target = BuildTarget.StandaloneWindows64,
                options = BuildOptions.None,
            };
            Debug.Log($"[BuildScript] verify -> {outExe}");
            BuildReport report = BuildPipeline.BuildPlayer(options);
            EditorApplication.Exit(report.summary.result == BuildResult.Succeeded ? 0 : 1);
        }

        [MenuItem("{{PROJECT_NAME}}/Build Windows (current day)")]
        public static void BuildWindows()
        {
            Directory.CreateDirectory(BuildDir);
            string ts = System.DateTime.Now.ToString("yyyy-MM-dd");
            string day = System.Environment.GetEnvironmentVariable("MELONS_BUILD_DAY") ?? "X";
            string outDir = Path.Combine(BuildDir, $"day-{day}-{ts}");
            Directory.CreateDirectory(outDir);
            string outExe = Path.Combine(outDir, ExeName);

            // Include MenuScene only if it actually exists (single-scene
            // games like Suika don't have a menu).
            var sceneList = new System.Collections.Generic.List<string> { GameScene };
            if (File.Exists(MenuScene)) sceneList.Insert(0, MenuScene);

            var options = new BuildPlayerOptions
            {
                scenes = sceneList.ToArray(),
                locationPathName = outExe,
                target = BuildTarget.StandaloneWindows64,
                options = BuildOptions.None,
            };
            Debug.Log($"[BuildScript] building -> {outExe} (scenes: {sceneList.Count})");
            BuildReport report = BuildPipeline.BuildPlayer(options);
            if (report.summary.result == BuildResult.Succeeded)
            {
                Debug.Log($"[BuildScript] OK ({report.summary.totalSize / 1024 / 1024} MB)");
                EditorApplication.Exit(0);
            }
            else
            {
                Debug.LogError($"[BuildScript] FAIL: {report.summary.result}");
                EditorApplication.Exit(1);
            }
        }
    }
}
