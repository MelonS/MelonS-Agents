using System.IO;
using UnityEngine;
using UnityEditor;
using UnityEditor.SceneManagement;
using UnityEngine.UI;
using {{NAMESPACE}};

namespace {{NAMESPACE}}.EditorTools
{
    public static class SceneSetup
    {
        private const string ScenesDir = "Assets/Scenes";
        private const string GamePath = "Assets/Scenes/Game.unity";
        private const string PrefabsDir = "Assets/Prefabs";

        // List every sprite path your game uses here.  ForceImportAllSprites
        // will run on each before any LoadAssetAtPath<Sprite>() call —
        // prevents the null-sprite-reference race documented at
        // skills/game-dev-agent/templates/editor/lessons.md (TODO).
        private static readonly string[] SpritePaths = new[]
        {
            // "Assets/Sprites/player.png",
            // "Assets/Sprites/enemy.png",
        };

        private static readonly string[] AudioPaths = new[]
        {
            // "Assets/Audio/click.wav",
        };

        [MenuItem("{{PROJECT_NAME}}/Generate All")]
        public static void GenerateAll()
        {
            Debug.Log("[SceneSetup] Starting...");
            Directory.CreateDirectory(ScenesDir);
            Directory.CreateDirectory(PrefabsDir);

            ForceImportAllAssets();
            GenerateGame();
            RegisterBuildScenes();

            AssetDatabase.SaveAssets();
            AssetDatabase.Refresh();
            Debug.Log("[SceneSetup] Done.");
        }

        /// <summary>
        /// Force-import every sprite + audio asset as the right Unity type
        /// BEFORE any LoadAssetAtPath call.  Without this, .meta files
        /// missing/stale -> sprite refs in the saved scene are null at
        /// build time (the 2026-05-26 invisible-world bug).
        /// </summary>
        private static void ForceImportAllAssets()
        {
            foreach (var p in SpritePaths)
            {
                if (!File.Exists(p)) { Debug.LogWarning($"[SceneSetup] missing sprite: {p}"); continue; }
                AssetDatabase.ImportAsset(p, ImportAssetOptions.ForceUpdate);
                TextureImporter ti = AssetImporter.GetAtPath(p) as TextureImporter;
                if (ti == null) continue;
                ti.textureType = TextureImporterType.Sprite;
                ti.spriteImportMode = SpriteImportMode.Single;
                ti.spritePixelsPerUnit = 16;
                ti.filterMode = FilterMode.Point;
                ti.SaveAndReimport();
            }
            foreach (var p in AudioPaths)
            {
                if (File.Exists(p))
                    AssetDatabase.ImportAsset(p, ImportAssetOptions.ForceUpdate);
            }
            AssetDatabase.Refresh();
            AssetDatabase.SaveAssets();
        }

        private static void GenerateGame()
        {
            var scene = EditorSceneManager.NewScene(NewSceneSetup.EmptyScene, NewSceneMode.Single);

            // === Camera ===
            var camGO = new GameObject("Main Camera");
            var cam = camGO.AddComponent<Camera>();
            cam.orthographic = true;
            cam.orthographicSize = 6f;
            cam.clearFlags = CameraClearFlags.SolidColor;   // CRITICAL: skybox otherwise leaks through 2D scenes
            cam.backgroundColor = new Color(0.12f, 0.13f, 0.18f);
            cam.transform.position = new Vector3(0, 0, -10);
            camGO.tag = "MainCamera";
            camGO.AddComponent<AudioListener>();

            // === EventSystem (for any UI) ===
            var esGO = new GameObject("EventSystem");
            esGO.AddComponent<UnityEngine.EventSystems.EventSystem>();
            esGO.AddComponent<UnityEngine.EventSystems.StandaloneInputModule>();

            // === Canvas (HUD) ===
            var canvasGO = new GameObject("Canvas");
            var canvas = canvasGO.AddComponent<Canvas>();
            canvas.renderMode = RenderMode.ScreenSpaceOverlay;
            canvasGO.AddComponent<CanvasScaler>();
            canvasGO.AddComponent<GraphicRaycaster>();

            // === AutoScreenshotter (required for agent.py qa) ===
            var ssGO = new GameObject("AutoScreenshotter");
            ssGO.AddComponent<AutoScreenshotter>();

            // ===========================================================
            //   TODO: add your game-specific content below
            //         (player spawn, walls, UI text, etc.)
            // ===========================================================

            EditorSceneManager.SaveScene(scene, GamePath);
            Debug.Log($"[SceneSetup] saved {GamePath}");
        }

        private static void RegisterBuildScenes()
        {
            var build = new System.Collections.Generic.List<EditorBuildSettingsScene>
            {
                new EditorBuildSettingsScene(GamePath, true),
            };
            EditorBuildSettings.scenes = build.ToArray();
            Debug.Log("[SceneSetup] build scenes registered.");
        }
    }
}
