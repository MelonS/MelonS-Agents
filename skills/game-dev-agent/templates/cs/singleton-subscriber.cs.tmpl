//      value forever.
//
// Pattern: POLL via Update with a change guard.  Avoids the
// Awake/OnEnable ordering trap entirely.  Cost: 1 cmp per frame.
// Worth it for UI that mirrors a singleton's scalar state (score,
// hp, resource counts, current weapon).

using UnityEngine;
using UnityEngine.UI;

namespace {{NAMESPACE}}
{
    [RequireComponent(typeof(Text))]
    public class {{CLASS_NAME}} : MonoBehaviour
    {
        // Override in subclass: read current value from your singleton.
        // Returns "" (empty) if singleton not yet ready.
        protected virtual string GetCurrentText()
        {
            return ""; // e.g. return ScoreManager.Instance != null ? $"Score: {ScoreManager.Instance.Score}" : "";
        }

        private Text txt;
        private string lastShown = "<<uninit>>";

        private void Awake()
        {
            txt = GetComponent<Text>();
            if (txt != null) txt.text = "";
        }

        private void Update()
        {
            string cur = GetCurrentText();
            if (cur == lastShown) return;
            if (txt != null) txt.text = cur;
            lastShown = cur;
        }
