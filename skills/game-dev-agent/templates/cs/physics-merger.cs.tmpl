//
// Lessons baked in:
//   #5 GetInstanceID component-vs-GO bug (Suika Day 2 2026-05-26) —
//      Comparing this.GetInstanceID() against collision.gameObject.
//      GetInstanceID() is broken: component IDs are ALWAYS larger
//      than GameObject IDs (components are created after GameObjects),
//      so both sides bail.  Must compare gameObject.GetInstanceID()
//      on BOTH sides.
//
//   #6 OnCollisionEnter2D miss after spawn-grace (Suika Day 2) —
//      Enter fires only on first contact.  If both bodies are still
//      in their justSpawned grace window when first contact happens,
//      the guard returns and Enter is never re-fired on the resting
//      contact.  Hook OnCollisionStay2D too so the merge fires once
//      grace expires.
//
// Generic same-tier merger.  Subclass + override the entity field
// + the Merge() callback.  Designed for Suika-style merge games,
// but applies to any "two same-kind bodies touch -> become next kind"
// pattern (chemistry, breeding, fusion etc.).

using UnityEngine;

namespace {{NAMESPACE}}
{
    [RequireComponent(typeof(Collider2D))]
    public abstract class {{CLASS_NAME}} : MonoBehaviour
    {
        // Override in subclass: how do two entities "match"?
        protected abstract bool SameKind(GameObject self, GameObject other);

        // Override in subclass: what happens on a successful merge?
        // Implementation typically: destroy both, spawn next-tier entity
        // at midpoint, award score, play SFX, spawn popup.
        protected abstract void OnMerge(GameObject self, GameObject other, Vector3 midpoint);

        // Set to true once Merge fires on this side, to prevent
        // double-merge in the same physics step.
        protected bool merged = false;

        // Spawn-grace flag — set true when this entity is fresh and
        // shouldn't collide-merge yet.  See spawned-entity.cs.tmpl.
        protected bool inGrace = false;

        private void OnCollisionEnter2D(Collision2D c) => TryMerge(c);
        private void OnCollisionStay2D(Collision2D c)  => TryMerge(c);

        private void TryMerge(Collision2D collision)
        {
            if (merged || inGrace) return;
            if (collision.gameObject == null) return;

            var otherMerger = collision.gameObject.GetComponent<{{CLASS_NAME}}>();
            if (otherMerger == null || otherMerger.merged || otherMerger.inGrace) return;

            if (!SameKind(gameObject, collision.gameObject)) return;

            // Tiebreaker: ONLY the lower-GO-ID side processes.
            // CRITICAL: use gameObject.GetInstanceID() on BOTH sides.
            // Comparing component IDs vs GO IDs is the GetInstanceID
            // race documented in lessons.md #5.
            if (gameObject.GetInstanceID() > collision.gameObject.GetInstanceID()) return;

            merged = true;
            otherMerger.merged = true;
            Vector3 mid = (transform.position + collision.transform.position) * 0.5f;
            OnMerge(gameObject, collision.gameObject, mid);
        }
    }
}
