using UnityEngine;

namespace {{NAMESPACE}}
{
    public class {{CLASS_NAME}} : MonoBehaviour
    {
        [SerializeField] private float audioInterval = 0.45f;
        private float lastAudioTime = -10f;

        // Call this anywhere audio should fire — it self-throttles.
        protected void PlayThrottled(System.Action playAction)
        {
            if (Time.time - lastAudioTime < audioInterval) return;
            playAction?.Invoke();
            lastAudioTime = Time.time;
        }

