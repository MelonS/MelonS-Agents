<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.melons.agents.auditor</string>

  <!-- §8 exception: launchd plist values do not expand shell variables
       like $HOME, so absolute paths are required.  When the repo is
       relocated, re-run scripts/install-scheduler.sh on the new machine
       to regenerate the LaunchAgents copy. -->
  <key>ProgramArguments</key>
  <array>
    <string>@@REPO_ROOT@@/scripts/audit-run.sh</string>
    <string>all</string>
  </array>

  <key>WorkingDirectory</key>
  <string>@@REPO_ROOT@@</string>

  <key>StandardOutPath</key>
  <string>@@REPO_ROOT@@/records/audit/launchd.out.log</string>

  <key>StandardErrorPath</key>
  <string>@@REPO_ROOT@@/records/audit/launchd.err.log</string>

  <!-- Run once a day at 03:00 local time (system idle, no work conflicts) -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>3</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>

  <!-- Do NOT fire on install — the first run consumes Anthropic API tokens
       (the auditor subagent is sonnet) and we don't want install-time
       surprises.  First scheduled fire is 03:00 the next day.  For an
       immediate check, run scripts/audit-run.sh manually. -->
  <key>RunAtLoad</key>
  <false/>

  <!-- launchd inherits a minimal PATH; nvm-managed node bins (where the
       claude CLI lives) are NOT included by default.  The audit-run.sh
       script has a fallback glob for ~/.nvm/versions/node/*/bin so it
       still works without us hardcoding a specific node version here,
       but we also add ~/.local/bin and /opt/homebrew/bin up front so
       most user-installed tools are reachable directly. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>@@HOME@@/.local/bin:@@HOME@@/.local/opt/ffmpeg-static:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
</dict>
</plist>
