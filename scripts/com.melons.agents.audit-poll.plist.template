<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.melons.agents.audit-poll</string>

  <!-- §8 exception: launchd plist values do not expand shell variables
       like $HOME, so absolute paths are required.  When the repo is
       relocated, re-run scripts/install-scheduler.sh on the new machine
       to regenerate the LaunchAgents copy. -->
  <key>ProgramArguments</key>
  <array>
    <string>@@REPO_ROOT@@/scripts/audit-poll.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>@@REPO_ROOT@@</string>

  <key>StandardOutPath</key>
  <string>@@REPO_ROOT@@/records/audit/poll.out.log</string>

  <key>StandardErrorPath</key>
  <string>@@REPO_ROOT@@/records/audit/poll.err.log</string>

  <!-- Run every 15 minutes.  Most polls are no-op file reads (cheap);
       only a real anomaly pattern triggers audit-run.sh (which uses
       the Anthropic API). -->
  <key>StartInterval</key>
  <integer>900</integer>

  <!-- Do NOT fire on install — would burn an unexpected audit if any
       blocker happens to be in the state at install time.  First
       scheduled fire is 15 min after launchd loads the job. -->
  <key>RunAtLoad</key>
  <false/>

  <!-- Same minimal-PATH problem as the auditor job (claude CLI lives
       under nvm).  The auditor wrapper handles fallback discovery,
       but we widen PATH up front for any other tools the poll script
       might invoke. -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>@@HOME@@/.local/bin:@@HOME@@/.local/opt/ffmpeg-static:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
</dict>
</plist>
