<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.melons.agents.queue</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/melons/ai/scripts/mission-queue.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/melons/ai</string>

  <key>StandardOutPath</key>
  <string>/Users/melons/ai/records/queue/launchd.out.log</string>

  <key>StandardErrorPath</key>
  <string>/Users/melons/ai/records/queue/launchd.err.log</string>

  <!-- Run every 30 minutes -->
  <key>StartInterval</key>
  <integer>1800</integer>

  <key>RunAtLoad</key>
  <true/>

  <!-- Inherit a richer PATH so brew / static-ffmpeg are findable -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Users/melons/.local/opt/ffmpeg-static:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>AUTONOMY_MODE</key>
    <string>true</string>
  </dict>
</dict>
</plist>
