<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.melons.agents.queue</string>

  <!-- §8 exception: launchd plist values do not expand shell variables
       like $HOME, so absolute paths are required.  When the repo is
       relocated, re-run scripts/install-scheduler.sh on the new machine
       to regenerate the LaunchAgents copy. -->
  <key>ProgramArguments</key>
  <array>
    <string>@@REPO_ROOT@@/scripts/mission-queue.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>@@REPO_ROOT@@</string>

  <key>StandardOutPath</key>
  <string>@@REPO_ROOT@@/records/queue/launchd.out.log</string>

  <key>StandardErrorPath</key>
  <string>@@REPO_ROOT@@/records/queue/launchd.err.log</string>

  <!-- Run every 30 minutes -->
  <key>StartInterval</key>
  <integer>1800</integer>

  <key>RunAtLoad</key>
  <true/>

  <!-- Inherit a richer PATH so brew / static-ffmpeg are findable -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>@@HOME@@/.local/opt/ffmpeg-static:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>AUTONOMY_MODE</key>
    <string>true</string>
  </dict>
</dict>
</plist>
