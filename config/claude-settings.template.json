{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read(@@HOME@@/**)",
      "Write(@@REPO_ROOT@@/**)",
      "Edit(@@REPO_ROOT@@/**)",
      "Write(@@HOME@@/.local/share/whisper-models/**)",
      "Write(@@HOME@@/.claude/projects/@@MEMORY_NAMESPACE@@/memory/**)",
      "Bash(claude *)",
      "Bash(python3 *)",
      "Bash(pip3 *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(brew *)",
      "Bash(ollama *)",
      "Bash(ffmpeg *)",
      "Bash(ffprobe *)",
      "Bash(aubiotrack *)",
      "Bash(aubioonset *)",
      "Bash(aubionotes *)",
      "Bash(aubiomfcc *)",
      "Bash(yt-dlp *)",
      "Bash(whisper-cli *)",
      "Bash(whisper *)",
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(mkdir *)",
      "Bash(mv *)",
      "Bash(cp *)",
      "Bash(rm @@REPO_ROOT@@/**)",
      "Bash(rm /tmp/**)",
      "Bash(rm ~/.Trash/**)",
      "Bash(chmod *)",
      "Bash(touch *)",
      "Bash(ln *)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(du *)",
      "Bash(df *)",
      "Bash(tree *)",
      "Bash(stat *)",
      "Bash(file *)",
      "Bash(tail *)",
      "Bash(head *)",
      "Bash(wc *)",
      "Bash(echo *)",
      "Bash(printf *)",
      "Bash(which *)",
      "Bash(whereis *)",
      "Bash(env)",
      "Bash(env | *)",
      "Bash(pgrep *)",
      "Bash(pkill *)",
      "Bash(kill *)",
      "Bash(ps *)",
      "Bash(lsof *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(sed *)",
      "Bash(awk *)",
      "Bash(jq *)",
      "Bash(yq *)",
      "Bash(diff *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(cut *)",
      "Bash(tr *)",
      "Bash(xargs *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(http *)",
      "Bash(security find-*)",
      "Bash(launchctl list *)",
      "Bash(cd @@REPO_ROOT@@ && *)",
      "Bash(cd @@REPO_ROOT@@/* && *)"
    ],
    "defaultMode": "bypassPermissions",
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf $HOME)",
      "Bash(rm -rf @@HOME_PARENT@@)",
      "Bash(rm -rf @@HOME@@)",
      "Bash(rm -rf /System*)",
      "Bash(rm -rf /Library*)",
      "Bash(rm -rf /Applications*)",
      "Bash(dd if=* of=/dev/*)",
      "Bash(diskutil eraseDisk *)",
      "Bash(diskutil erase*)",
      "Bash(launchctl unload /System/*)",
      "Bash(sudo *)",
      "Bash(git push --force origin main)",
      "Bash(git push --force-with-lease origin main)",
      "Bash(git push -f origin main)",
      "Bash(git push --force *main)",
      "Bash(git reset --hard origin/main)",
      "Bash(curl * | sh)",
      "Bash(curl * | bash)",
      "Bash(wget * | sh)",
      "Bash(wget * | bash)"
    ]
  },
  "_notes": {
    "rationale": "Auto-approve mode. Wide allow for tactical commands needed by the agent system. Deny list guards catastrophic operations (rm -rf at system roots, sudo, force-push to main, disk erase, piped-curl-to-shell).",
    "scope": "Rendered from config/claude-settings.template.json by scripts/install-claude-local.sh at install time. Placeholders @@HOME@@ / @@REPO_ROOT@@ / @@HOME_PARENT@@ / @@MEMORY_NAMESPACE@@ are substituted with values from the operator's environment so the file works on any qualified machine. See operator-contract.md §8 principle 4 (multi-machine portable).",
    "regenerate": "./scripts/install-claude-local.sh"
  },
  "statusLine": {
    "type": "command",
    "command": ".claude/statusline.sh",
    "padding": 0
  }
}
