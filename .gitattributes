# Cross-platform line-ending normalization.
# Without this, Windows git auto-converts LF -> CRLF for text files which
# breaks bash shebangs (`#!/usr/bin/env bash` followed by \r\n confuses
# the kernel) and confuses tools like jq / yq that expect LF input.
#
# Policy: LF is canonical for source / scripts / data.  Windows users
# may see CRLF in their working tree for editor-friendly file types
# (txt, csv) but everything that's *executed* stays LF.

# Default: let git decide based on content, treat unknown as text.
* text=auto

# Force LF for things that get executed or parsed by tools that hate CRLF
*.sh        text eol=lf
*.py        text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.toml      text eol=lf
*.ini       text eol=lf
*.cfg       text eol=lf
*.conf      text eol=lf
# .tsv is parsed field-by-field (skills/job-hunt/config/activation.tsv); a
# trailing \r rides along on the last column and silently breaks lookups.
# Flagged by six consecutive audit cycles as "job-hunt CRLF contamination".
*.tsv       text eol=lf
*.env*      text eol=lf
.gitignore  text eol=lf
.gitattributes text eol=lf
Makefile    text eol=lf
*.mk        text eol=lf

# PowerShell scripts are Windows-native — keep CRLF there
*.ps1       text eol=crlf
*.psm1      text eol=crlf
*.psd1      text eol=crlf
*.cmd       text eol=crlf
*.bat       text eol=crlf

# Binary — never normalize
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.mp3       binary
*.mp4       binary
*.wav       binary
*.flac      binary
*.safetensors binary
*.pt        binary
*.pth       binary
*.ckpt      binary
*.onnx      binary
*.zip       binary
*.7z        binary
*.tar.gz    binary
*.tgz       binary
*.bin       binary
