    "defaultMode": "bypassPermissions",
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf $HOME)",
      "Bash(rm -rf /Users)",
      "Bash(rm -rf /Users/melons)",
      "Bash(rm -rf /System*)",
      "Bash(rm -rf /Library*)",
      "Bash(rm -rf /Applications*)",
      "Bash(dd if=* of=/dev/*)",
      "Bash(diskutil eraseDisk *)",
      "Bash(diskutil erase*)",
      "Bash(launchctl unload /System/*)",
      "Bash(sudo *)",
      "Bash(git push --force origin main)",
      "Bash(git push --force-with-lease origin main)",
      "Bash(git push -f origin main)",
      "Bash(git push --force *main)",
      "Bash(git reset --hard origin/main)",
      "Bash(curl * | sh)",
      "Bash(curl * | bash)",
      "Bash(wget * | sh)",
      "Bash(wget * | bash)"
    ]
  },
  "_notes": {
    "rationale": "Auto-approve mode per user directive 2026-05-14. Wide allow for tactical commands needed by the agent system. Deny list guards against catastrophic operations (rm -rf at system roots, sudo, force-push to main, disk erase, piped-curl-to-shell).",
