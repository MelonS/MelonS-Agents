# =============================================================================
# Multi-Agent System — Environment Configuration
# =============================================================================
# Copy to `.env` and fill in. `.env` is gitignored.
# All tool paths and endpoints are env-managed for Linux portability.
# =============================================================================

# --- Paths (override for Linux deploy) ------------------------------------
# Use `which ffmpeg` / `which ollama` on the target host
FFMPEG_BIN=/Users/melons/.local/opt/ffmpeg-static/ffmpeg
FFPROBE_BIN=/Users/melons/.local/opt/ffmpeg-static/ffprobe
OLLAMA_BIN=/opt/homebrew/bin/ollama
YT_DLP_BIN=/opt/homebrew/bin/yt-dlp
WHISPER_CLI_BIN=/opt/homebrew/bin/whisper-cli

# --- Model files (large binaries kept outside repo) ----------------------
# whisper.cpp multilingual model. base = fast/EN-only-good, small = multilingual-decent.
# For Korean/Japanese/Chinese sources prefer small or medium.
WHISPER_MODEL=${HOME}/.local/share/whisper-models/ggml-small.bin

# --- Data layer ----------------------------------------------------------
# Where agents write outputs. Default: ./records (relative to repo root)
RECORDS_DIR=./records

# --- Ollama (local inference for autonomous overnight runs) --------------
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL_HIGHLIGHT=llama3.2:3b
OLLAMA_MODEL_PLANNING=llama3.1:8b
OLLAMA_MODEL_EDITING=qwen2.5-coder:7b

# --- Claude API (for orchestrator + critical reasoning) ------------------
# ANTHROPIC_API_KEY=  # set in shell, do NOT commit
ANTHROPIC_MODEL_ORCHESTRATOR=claude-opus-4-7
ANTHROPIC_MODEL_SUBAGENT=claude-sonnet-4-6

# --- Fixture sources (for synthetic test fixtures) -----------------------
# Pexels Videos API — used by scripts/pexels-fetch.sh to pull stock B-roll
# for bootstrap fixtures. Free tier: 200 req/hour, 20k req/month.
# Get a key at https://www.pexels.com/api/
PEXELS_API_KEY=

# --- Layout engine -------------------------------------------------------
# Geometry constants for the 9:16 short renderer. Defaults aim for a TikTok/
# Shorts/Reels-safe layout: captions live in the lower third inside the
# horizontal safe zone, with a semi-transparent box behind them. Override
# per-host if a target platform changes its safe area.
LAYOUT_SAFE_MARGIN_V=280       # px from bottom edge (keeps caption above bottom UI)
LAYOUT_SAFE_MARGIN_H=100       # px left/right (keeps caption away from action rail)
LAYOUT_FONT_SIZE=44            # body caption size at 1080x1920
LAYOUT_FONT_NAME=Helvetica     # libass font (resolved via fontconfig)
LAYOUT_BOX_OPACITY_HEX=80      # libass alpha for the caption box: 00=opaque, FF=fully transparent
LAYOUT_DRAWTEXT_FONTFILE=/System/Library/Fonts/Supplemental/AppleGothic.ttf  # Hangul + Latin in single .ttf

# --- Autonomy policy -----------------------------------------------------
# When true, agents may run missions without user confirmation (overnight mode)
AUTONOMY_MODE=false
# Maximum cost ceiling (USD) before pausing for confirmation
AUTONOMY_BUDGET_USD=5.00
