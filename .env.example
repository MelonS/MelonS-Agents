# =============================================================================
# Multi-Agent System — Environment Configuration
# =============================================================================
# Copy to `.env` and adjust as needed.  `.env` is gitignored.
#
# Almost every binary path below is intentionally blank.  `agents/lib/env.sh`
# resolves blank bin vars via `command -v` at runtime, so a working PATH
# install (Homebrew on macOS, apt/pacman on Linux, etc.) is enough.
# Set a value explicitly only when you have a non-PATH install or want a
# specific build (e.g., a custom static ffmpeg with libass).
# =============================================================================

# --- Tool binaries --------------------------------------------------------
# Where to obtain each tool:
#   ffmpeg / ffprobe : macOS  `brew install ffmpeg-full`  (regular
#                              `ffmpeg` no longer ships with libass)
#                      Linux  `apt install ffmpeg`   (or equivalent —
#                              libass is bundled in most distros)
#   ollama           : https://ollama.com/download
#   yt-dlp           : `brew install yt-dlp` / `pipx install yt-dlp`
#   whisper-cli      : `brew install whisper-cpp`
#                       (the formula installs both `whisper-cli` and
#                        `whisper-server` binaries)
#
# Leave blank to auto-discover via PATH.  Override only if needed.
FFMPEG_BIN=
FFPROBE_BIN=
OLLAMA_BIN=
YT_DLP_BIN=
WHISPER_CLI_BIN=

# --- Model files (large binaries kept outside repo) -----------------------
# whisper.cpp multilingual model.  Run `scripts/fetch-whisper-model.sh`
# after the first `cp .env.example .env` to download (~150 MB).
#   ggml-base.bin  : English-only, fast
#   ggml-small.bin : multilingual, decent quality (Korean / JA / ZH usable) ← default
#   ggml-medium.bin: multilingual, better quality, ~2× the size
WHISPER_MODEL=${HOME}/.local/share/whisper-models/ggml-small.bin

# --- Data layer -----------------------------------------------------------
# Where agents write outputs. Default: ./records (relative to repo root)
RECORDS_DIR=./records

# --- Ollama (local inference) --------------------------------------------
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL_HIGHLIGHT=llama3.2:3b
OLLAMA_MODEL_PLANNING=llama3.1:8b
OLLAMA_MODEL_EDITING=qwen2.5-coder:7b

# --- Claude API (optional — only the orchestrator uses it) ---------------
# Missions themselves run without any Anthropic call (see docs/cost-model.md).
# Set ANTHROPIC_API_KEY in your shell, NOT in this file.
ANTHROPIC_MODEL_ORCHESTRATOR=claude-opus-4-7
ANTHROPIC_MODEL_SUBAGENT=claude-sonnet-4-6

# --- Fixture sources -----------------------------------------------------
# Pexels Videos API — optional, used by scripts/pexels-fetch.sh to pull
# stock B-roll for bootstrap fixtures.  Free tier: 200 req/hour,
# 20k req/month.  Get a key at https://www.pexels.com/api/
PEXELS_API_KEY=

# --- Layout engine -------------------------------------------------------
# Geometry constants for the 9:16 short renderer.  Defaults target a
# TikTok / Shorts / Reels-safe layout.
LAYOUT_SAFE_MARGIN_V=280        # px from bottom edge
LAYOUT_SAFE_MARGIN_H=100        # px left / right
LAYOUT_FONT_SIZE=44             # body caption size at 1080x1920
LAYOUT_FONT_NAME=Helvetica      # libass font (resolved via fontconfig)
LAYOUT_BOX_OPACITY_HEX=80       # libass alpha: 00=opaque, FF=fully transparent

# Font file for ffmpeg drawtext (top-left source-attribution overlay).
# Must be a single .ttf with Latin + Hangul coverage if you process
# Korean sources.  Pipeline falls back gracefully if the path is missing,
# but glyphs may render as boxes — set a real font to avoid that.
#   macOS default : /System/Library/Fonts/Supplemental/AppleGothic.ttf
#   Linux ideas   : run `fc-list :lang=ko file` and paste any .ttf path
#                   (e.g. a Noto Sans CJK KR file).  Leave blank to let
#                   ffmpeg pick whatever the OS defaults to.
LAYOUT_DRAWTEXT_FONTFILE=

# --- Autonomy policy -----------------------------------------------------
# When true, agents may run missions without user confirmation (overnight mode)
AUTONOMY_MODE=false
# Maximum cost ceiling (USD) before pausing for confirmation
AUTONOMY_BUDGET_USD=5.00

# Optional: hardware H.264 encoder for final renders (default: libx264;
# macOS auto-selects videotoolbox). e.g. h264_nvenc (NVIDIA), h264_qsv, h264_amf.
# RTX 4070 Ti SUPER benchmark 2026-07-03: 4.1x faster than libx264.
#VIDEO_ENCODER=h264_nvenc

# --- graph/ (LangGraph 실행 엔진) ----------------------------------------
# 쇼츠 라인 — 스틸/영상 생성 서버. graph/tools.py 가 읽는다.
#COMFYUI_URL=http://127.0.0.1:8188

# 게임 라인 — Unity Editor 실행 파일. graph/game_nodes.py 가 batchmode 로 부른다.
# Unity Hub 가 기본 경로를 안 쓸 수 있다: %APPDATA%\UnityHub\secondaryInstallPath.json
# 확인. 프로젝트가 요구하는 버전은 unity-project/ProjectSettings/ProjectVersion.txt.
#UNITY_EXE=G:\tools\UnityEditors\6000.0.75f1\Editor\Unity.exe

# 심사위원 모델. 샷당 반복 호출이라 실행 토큰의 최대 덩어리 — 기본 Sonnet.
#JUDGE_MODEL=claude-sonnet-5

# Windows 전용: bash 는 WSL 스텁이라 PowerShell/파이썬에서 부르면 rc=-1 로 죽는다.
# graph/tools.py::bash_bin() 이 Git Bash 를 자동 탐색하지만, 비표준 위치면 지정.
# 자세한 내용: docs/platform-windows.md
#BASH_BIN=C:\Program Files\Git\bin\bash.exe

# --- 유료 TTS / 음악 (선택, money firewall 대상) --------------------------
# 값을 넣지 않으면 해당 경로는 그냥 비활성이다. 키 파일 경로를 주는 방식도 지원
# (scripts/elevenlabs-*.py, scripts/typecast-*.py 가 $*_API_KEY → $*_KEY_FILE
# 순으로 읽는다). 실제 키는 절대 커밋하지 않는다 — config/ 는 gitignored.
#ELEVENLABS_API_KEY=
#ELEVENLABS_KEY_FILE=
#TYPECAST_API_KEY=
#TYPECAST_KEY_FILE=

# --- YouTube 분석 (선택) --------------------------------------------------
# client_secrets.json + analytics.token 이 들어 있는 디렉터리.
# scripts/yt-analytics-*.py, scripts/yt-scoreboard.py 가 읽는다.
#YT_CONFIG_DIR=

# --- 게임 라인 검증 스크래치 (선택) --------------------------------------
# refactor_check.py 가 스크린샷 baseline·Unity 로그·테스트 리포트를 쓰는 곳.
# 저장소 밖이어야 한다(용량 크고 매 사이클 재생성). 기본값은 저장소의 부모 디렉터리.
#PAWNSIM_SCRATCH_DIR=
# Unity Player.log 경로. 기본값은 실행 사용자의 LocalLow 에서 유도한다.
#PAWNSIM_PLAYER_LOG=
